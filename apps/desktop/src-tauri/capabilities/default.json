{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main terminal window. Only what the terminal actually uses.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "core:app:default",
    "core:event:default",
    "core:tray:default",
    "core:menu:default",
    "updater:default",
    "stronghold:default",
    "process:default",
    "process:allow-restart",
    "opener:default",
    "opener:allow-open-url",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:*" },
        { "url": "http://127.0.0.1:*" },
        { "url": "ws://localhost:*" },
        { "url": "ws://127.0.0.1:*" }
      ]
    }
  ]
}
