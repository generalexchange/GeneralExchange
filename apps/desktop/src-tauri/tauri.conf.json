{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "General Exchange",
  "version": "0.2.8",
  "identifier": "exchange.general.terminal",
  "build": {
    "beforeDevCommand": "npm --prefix ../.. run dev",
    "devUrl": "http://localhost:3003",
    "beforeBuildCommand": "node ../../scripts/build-desktop-frontend.mjs",
    "frontendDist": "../../../out"
  },
  "app": {
    "windows": [
      {
        "label": "splashscreen",
        "url": "splash.html",
        "title": "General Exchange",
        "width": 420,
        "height": 420,
        "resizable": false,
        "center": true,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true
      },
      {
        "label": "main",
        "title": "General Exchange",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 800,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": false
      }
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "General Exchange"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "publisher": "Old West Solutions",
    "category": "Finance",
    "shortDescription": "general.exchange desktop app",
    "longDescription": "The full general.exchange platform as a native desktop application — bundled UI connecting to IBKR and market services on your local machine (127.0.0.1).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/generalexchange/GeneralExchange/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1Rjg0RjNCMjk3QTUwRTEKUldUaFVIb3BPMC80TlVUMVV6dnpUNldRdTlzWCt0Nm83TFMzWDhjQWV2WldlNytub3hZNm8yT2sK"
    }
  }
}
