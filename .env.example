# Interactive Brokers (IBKR) — market data, options, account, orders
# See docs/IBKR_SETUP.md

# IB Gateway / TWS connection (paper trading defaults)
IB_HOST=127.0.0.1
IB_PORT=4002
IB_CLIENT_ID=1
IB_PAPER=true
IB_ACCOUNT=

# IBKR FastAPI service
IBKR_API_URL=http://localhost:8093
IBKR_API_KEY=
IBKR_PORT=8093

# PostgreSQL — historical bar storage
DATABASE_URL=postgresql+asyncpg://ibkr:ibkr@localhost:5432/ibkr
DATABASE_URL_SYNC=postgresql+psycopg2://ibkr:ibkr@localhost:5432/ibkr
POSTGRES_USER=ibkr
POSTGRES_PASSWORD=ibkr
POSTGRES_DB=ibkr

# WebSocket — IBKR stock price stream
NEXT_PUBLIC_WS_URL=ws://localhost:8093/ws/stocks?symbols=SPY,QQQ,NVDA
WS_SYMBOLS=SPY,QQQ,NVDA,AAPL,TSLA,AMD,MSFT,AMZN,META

# Monte Carlo (optional local service)
MONTE_CARLO_API_URL=http://localhost:8092
NEXT_PUBLIC_MONTE_CARLO_API_URL=/api/v1/monte-carlo
MC_API_KEY=
GE_API_KEY=gx_live_dev_demo_key

# Auth / site
JWT_SIGNING_SECRET=change-me-in-prod
NEXT_PUBLIC_ROOT_DOMAIN=general.exchange
NEXT_PUBLIC_LEGEND_URL=https://legend.general.exchange
SITE_URL=https://generalexchange.com

# Object storage (MinIO — local stand-in for the FloppyDisk strategy store)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
FLOPPYDISK_URL=
FLOPPYDISK_API_KEY=

# Observability (OpenObserve)
OO_ROOT_EMAIL=admin@general.exchange
OO_ROOT_PASSWORD=Complexpass#123

# Internal BI (Apache Superset)
SUPERSET_SECRET_KEY=change-me-in-prod

# API-key management
API_KEY_ENFORCE=false
DEV_API_KEY=gx_live_dev_demo_key

# Dashboard
NEXT_PUBLIC_AG_GRID_LICENSE=
