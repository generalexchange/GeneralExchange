# ---------------------------------------------------------------------
# general.exchange — environment template. Copy to .env and fill in.
# ---------------------------------------------------------------------

# Data ingestion (the only approved third-party data provider)
POLYGON_API_KEY=

# Object storage (MinIO — local stand-in for the FloppyDisk strategy store)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# FloppyDisk (floppydisk.cc) — separate external strategy-storage / marketplace
# service. Leave FLOPPYDISK_URL empty to use the local MinIO-backed stand-in;
# set it once the service is live to publish strategies + artifacts there.
FLOPPYDISK_URL=
FLOPPYDISK_API_KEY=

# Observability (OpenObserve)
OO_ROOT_EMAIL=admin@general.exchange
OO_ROOT_PASSWORD=Complexpass#123

# Internal BI (Apache Superset)
SUPERSET_SECRET_KEY=change-me-in-prod

# Frontend -> Go backend (server-side only; never exposed to the client)
GO_API_URL=http://localhost:8080
GO_WS_URL=ws://localhost:8081
# Server-side key the Next.js /api/v1 proxy sends to Go (must match a valid firm key)
GE_API_KEY=gx_live_dev_demo_key

# Auth
JWT_SIGNING_SECRET=change-me-in-prod
NEXT_PUBLIC_ROOT_DOMAIN=general.exchange

# SEO — canonical public URL for metadata, sitemap, and Open Graph (web deploy)
SITE_URL=https://generalexchange.com
# Google Search Console verification token (optional)
GOOGLE_SITE_VERIFICATION=

# Dashboard visualization layer (client-side)
# AG Grid Enterprise license — required only for row grouping/pivoting in the
# strategy library browser. Community features (options chain, positions,
# history) work without it; leave empty in dev.
NEXT_PUBLIC_AG_GRID_LICENSE=
# Live market WebSocket base URL for the dashboard's streaming charts/grids.
# Leave empty to drive the UI from deterministic mock data (no sockets opened);
# set to the Go WS server (e.g. ws://localhost:8081) to stream live.
NEXT_PUBLIC_WS_URL=

# ---------------------------------------------------------------------
# Vercel (Production → Settings → Environment Variables)
# Or run:  $env:VERCEL_TOKEN="..." ; node scripts/push-vercel-env.mjs
# ---------------------------------------------------------------------
# GO_API_URL=https://your-go-api.example.com   (leave unset on Vercel to use Polygon direct)
# GE_API_KEY=gx_live_dev_demo_key
# POLYGON_API_KEY=...                          (enables live market data on Vercel without Go)
# JWT_SIGNING_SECRET=...
# SITE_URL=https://generalexchange.com
# NEXT_PUBLIC_ROOT_DOMAIN=generalexchange.com
# NEXT_PUBLIC_WS_URL=wss://your-ws-server.example.com
# GOOGLE_SITE_VERIFICATION=...

# API-key management + metering (Go API)
# API_KEY_ENFORCE=true rejects unknown keys; false (dev) accepts them as free tier.
API_KEY_ENFORCE=false
DEV_API_KEY=gx_live_dev_demo_key
