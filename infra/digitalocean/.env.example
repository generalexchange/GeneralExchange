# Copy to /opt/ibkr-gateway/.env on the droplet (never commit real credentials).
#
# Recommended: store password in secrets/tws_password and reference the file so
# special characters (e.g. !) are not mangled by shell/env parsing.
TWS_USERID=your_ibkr_username
TWS_PASSWORD_FILE=/run/secrets/tws_password
TRADING_MODE=paper
READ_ONLY_API=no
TWS_ACCEPT_INCOMING=accept
EXISTING_SESSION_DETECTED_ACTION=primary
TWOFA_TIMEOUT_ACTION=restart
RELOGIN_AFTER_TWOFA_TIMEOUT=yes
VNC_SERVER_PASSWORD=changeme
SAVE_TWS_SETTINGS=yes
BYPASS_WARNING=yes
DismissPasswordExpiryWarning=yes
DismissNSEComplianceNotice=yes
AcceptNonBrokerageAccountWarning=yes
